{% comment %}
  The landing page shown while the store is password protected (password
  layout: no header or footer).

  The header's stacked mark, set large on the left; a stream of hawks crossing
  it (assets/password-flock.js, on a canvas over the mark and under the
  form); and, bottom right, the sign-up. The mailing list comes first; "I have
  a password" swaps it for the storefront password form in the same place.
  Without JS both forms show, one under the other.

  https://shopify.dev/docs/storefronts/themes/architecture/templates/password
{% endcomment %}

<div class="password full-width">
  <h1 class="password__mark">
    <span class="visually-hidden">seventeeneighteennineteen</span>
    <span class="password__mark-line password__mark-line--strong" aria-hidden="true">seventeen</span>
    <span class="password__mark-line" aria-hidden="true">eighteen</span>
    <span class="password__mark-line password__mark-line--strong" aria-hidden="true">nineteen</span>
  </h1>

  <div class="password__flock" data-password-flock aria-hidden="true"></div>

  <div class="password__panel">
    {%- if shop.password_message != blank -%}
      <p class="password__text">{{ shop.password_message }}</p>
    {%- endif -%}

    <div class="password__view" id="PasswordList" data-password-view="list">
      {% render 'newsletter-form', id: 'PasswordNewsletter', block: 'password', submit_label: 'Join the List' %}
      <button
        class="password__switch"
        type="button"
        aria-controls="PasswordEntry"
        data-password-switch="entry"
        hidden
      >
        I have a password
      </button>
    </div>

    <div class="password__view" id="PasswordEntry" data-password-view="entry">
      {%- form 'storefront_password', class: 'password__form' -%}
        <div class="password__field">
          <label class="password__label" for="Password">{{ 'password.password' | t }}</label>
          <input
            class="password__input"
            type="password"
            id="Password"
            name="password"
            autocomplete="current-password"
            required
            {% if form.errors %}
              aria-invalid="true" aria-describedby="PasswordError"
            {% endif %}
          >
          <button class="password__submit" type="submit">{{ 'password.enter' | t }}</button>
        </div>

        {%- if form.errors -%}
          <div class="password__message" id="PasswordError" role="alert">
            {{ form.errors | default_errors }}
          </div>
        {%- endif -%}
      {%- endform -%}
      <button
        class="password__switch"
        type="button"
        aria-controls="PasswordList"
        data-password-switch="list"
        hidden
      >
        I don't have a password
      </button>
    </div>
  </div>
</div>

{% javascript %}
  (function () {
    'use strict';

    var views = document.querySelectorAll('[data-password-view]');
    var switches = document.querySelectorAll('[data-password-switch]');
    if (!views.length) return;

    function show(name, moveFocus) {
      views.forEach(function (view) {
        view.hidden = view.getAttribute('data-password-view') !== name;
        if (!view.hidden && moveFocus) {
          var input = view.querySelector('input:not([type="hidden"])');
          if (input) input.focus();
        }
      });
    }

    switches.forEach(function (button) {
      button.hidden = false;
      button.addEventListener('click', function () {
        show(button.getAttribute('data-password-switch'), true);
      });
    });

    // A wrong password reloads the page with the error: stay on the password.
    show(document.querySelector('#Password[aria-invalid]') ? 'entry' : 'list', false);
  })();
{% endjavascript %}

{% stylesheet %}
  /* A single still screen: no strip held for a scrollbar (critical.css
     reserves one on every other page), no scrolling, and no overscroll
     bounce on phones. */
  html:has(.password) {
    scrollbar-gutter: auto;
  }

  html:has(.password),
  html:has(.password) body {
    overflow: hidden;
    overscroll-behavior: none;
  }

  /* The mark top left, the sign-up bottom right (the Figma's 1280 frame: the
     mark at 150px, the form 416px wide inside 64px margins). */
  .password {
    --password-ink: #fff;

    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 416px);
    grid-template-rows: 1fr auto;
    flex: 1;
    min-height: 100svh;
    min-height: 100dvh;
    padding: 40px 64px 64px;
    color: var(--password-ink);
    font-family: var(--font-secondary--family);
  }

  /* The header's mark (sections/header.liquid), at poster size: right-aligned
     within its own block, bold / regular / bold. Sized by width, and capped by
     height so short windows still fit the sign-up below it. */
  .password__mark {
    grid-column: 1;
    grid-row: 1;
    justify-self: start;
    align-self: start;
    /* Pulls the "s" onto the margin, as the header's Figma frame sets it. */
    margin: 0 0 0 -0.09em;
    font-family: var(--font-primary--family);
    font-size: min(11.72vw, 25svh);
    font-weight: 400;
    line-height: 0.9375;
    text-align: right;
  }

  .password__mark-line {
    display: block;
    letter-spacing: -0.04em;
  }

  .password__mark-line--strong {
    font-weight: 700;
    letter-spacing: -0.015em;
  }

  /* The birds fly over the mark and under the form; the canvas never takes
     the pointer. */
  .password__flock {
    position: fixed;
    inset: 0;
    pointer-events: none;
  }

  .password__panel {
    position: relative;
    grid-column: 2;
    grid-row: 2;
    font-size: 13px;
    line-height: 16px;
  }

  .password__text {
    margin: 0 0 24px;
  }

  .password__view {
    display: grid;
  }

  /* Without JS both forms show; space them apart. */
  .password__view + .password__view:not([hidden]) {
    margin-top: 32px;
  }

  .password__view[hidden] {
    display: none;
  }

  .password__form {
    margin: 0;
  }

  /* "Email ________" on one line, the white pill on the next. */
  .password__field {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    column-gap: 8px;
    row-gap: 20px;
    align-items: end;
  }

  .password__input {
    min-width: 0;
    height: 16px;
    padding: 0;
    border: 0;
    border-bottom: 1px solid color-mix(in srgb, var(--password-ink) 24%, transparent);
    border-radius: 0;
    background: none;
    color: inherit;
    font: inherit;
    line-height: 16px;
    outline: none;
    transition: border-color 150ms ease;
  }

  /* The rule itself is the focus indicator, as the footer's. */
  .password__input:focus-visible,
  .password__input[aria-invalid='true'] {
    border-bottom-color: var(--password-ink);
  }

  .password__submit {
    grid-column: 1 / -1;
    height: 30px;
    padding: 0 16px;
    border: 0;
    border-radius: 999px;
    background: var(--password-ink);
    color: var(--color-background);
    font: inherit;
    cursor: pointer;
    transition: background-color 150ms ease;
  }

  .password__submit:hover {
    background: var(--ink-hover);
  }

  .password__submit:focus-visible {
    outline: 1px solid var(--password-ink);
    outline-offset: 3px;
  }

  .password__switch {
    justify-self: center;
    margin-top: 18px;
    padding: 0;
    border: 0;
    background: none;
    color: color-mix(in srgb, var(--password-ink) 70%, transparent);
    font: inherit;
    font-size: 11px;
    line-height: 14px;
    text-decoration: underline;
    text-decoration-color: color-mix(in srgb, var(--password-ink) 40%, transparent);
    text-underline-offset: 3px;
    cursor: pointer;
    transition: color 150ms ease;
  }

  .password__switch[hidden] {
    display: none;
  }

  .password__switch:hover {
    color: var(--password-ink);
  }

  .password__switch:focus-visible {
    outline: 1px solid var(--password-ink);
    outline-offset: 4px;
  }

  /* Errors sit under the pill; success replaces the field. */
  .password__message {
    margin: 0;
  }

  .password__message[role='alert'] {
    margin-top: 10px;
    font-size: 11px;
    line-height: 14px;
  }

  .password__message :is(ul, li) {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* Phones: one column, the mark and the sign-up together in the middle of
     the screen (the Figma's 390 frame: the mark at 68px). */
  @media (max-width: 700px) {
    .password {
      grid-template-columns: minmax(0, 1fr);
      grid-template-rows: auto auto;
      align-content: center;
      row-gap: 72px;
      padding: 20px 20px 48px;
    }

    .password__mark {
      font-size: min(17.4vw, 14svh);
      margin-left: -0.06em;
    }

    .password__panel {
      grid-column: 1;
    }

    .password__submit {
      height: 36px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .password__input,
    .password__submit,
    .password__switch {
      transition-duration: 1ms;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.password",
  "settings": []
}
{% endschema %}
