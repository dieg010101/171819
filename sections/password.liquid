{% comment %}
  The landing page shown while the store is password protected (password
  layout: no header or footer).

  An image fills the viewport, seen through the mailing-list popup's #E3C51D
  difference layer, under a grey panel holding the shop's message, the
  storefront password form and the newsletter form. Both forms share the
  password__* classes, so their fields line up. Without an image the layer
  inverts the plain background instead.

  https://shopify.dev/docs/storefronts/themes/architecture/templates/password
{% endcomment %}

<div class="password full-width">
  {%- if section.settings.image != blank -%}
    {{
      section.settings.image
      | image_url: width: 3000
      | image_tag:
        class: 'password__image',
        widths: '750, 1100, 1500, 2200, 3000',
        sizes: '100vw',
        loading: 'eager',
        fetchpriority: 'high',
        alt: ''
    }}
  {%- endif -%}

  <div class="password__panel">
    <h1 class="password__title">{{ 'password.title' | t }}</h1>

    {%- if shop.password_message != blank -%}
      <p class="password__text">{{ shop.password_message }}</p>
    {%- endif -%}

    {%- form 'storefront_password', class: 'password__form' -%}
      <div class="password__field">
        <label class="password__label" for="Password">{{ 'password.password' | t }}</label>
        <input
          class="password__input"
          type="password"
          id="Password"
          name="password"
          autocomplete="current-password"
          required
          {% if form.errors %}
            aria-invalid="true" aria-describedby="PasswordError"
          {% endif %}
        >
        <button class="password__submit" type="submit" aria-label="{{ 'password.enter' | t }}"></button>
      </div>

      {%- if form.errors -%}
        <div class="password__message" id="PasswordError" role="alert">
          {{ form.errors | default_errors }}
        </div>
      {%- endif -%}
    {%- endform -%}

    {% render 'newsletter-form', id: 'PasswordNewsletter', block: 'password' %}
  </div>
</div>

{% stylesheet %}
  .password {
    --password-ink: #000;

    position: relative;
    isolation: isolate;
    display: grid;
    place-items: center;
    flex: 1;
    min-height: 100svh;
    padding: 20px;
    overflow: hidden;
    background-color: var(--color-background);
  }

  .password__image {
    position: absolute;
    inset: 0;
    z-index: -2;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* The popup's difference layer, here over the image rather than the page. */
  .password::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background-color: #e3c51d;
    mix-blend-mode: difference;
    pointer-events: none;
  }

  /* 432px wide, as the popup; sits a little above centre, as the popup does. */
  .password__panel {
    display: grid;
    gap: 20px;
    width: min(432px, 100%);
    margin-bottom: 3svh;
    padding: 32px 25px 29px 27px;
    background: #d9d9d9;
    color: var(--password-ink);
    font-family: var(--font-secondary--family);
    font-size: 11px;
    line-height: 12px;
    letter-spacing: -0.05em;
  }

  .password__title,
  .password__text {
    margin: 0;
    font: inherit;
    letter-spacing: inherit;
  }

  /* Label · rule · 8px square, as the popup's field. The label is wide enough
     for "Password", so the email rule below starts on the same line. */
  .password__field {
    display: flex;
    align-items: flex-end;
  }

  .password__label {
    flex: none;
    width: 52px;
  }

  .password__input {
    flex: 1;
    min-width: 0;
    height: 12px;
    padding: 0;
    border: 0;
    border-bottom: 1px solid color-mix(in srgb, var(--password-ink) 32%, transparent);
    border-radius: 0;
    background: none;
    color: inherit;
    font: inherit;
    line-height: 12px;
    letter-spacing: inherit;
    outline: none;
    transition: border-color 150ms ease;
  }

  /* The rule itself is the focus indicator. */
  .password__input:focus-visible,
  .password__input[aria-invalid='true'] {
    border-bottom-color: var(--password-ink);
  }

  .password__submit {
    position: relative;
    flex: none;
    width: 8px;
    height: 8px;
    margin: 0 0 2px 14px;
    padding: 0;
    border: 1px solid color-mix(in srgb, var(--password-ink) 45%, transparent);
    border-radius: 0;
    background: none;
    cursor: pointer;
  }

  .password__submit::before {
    content: '';
    position: absolute;
    inset: -12px;
  }

  .password__submit:hover {
    border-color: var(--password-ink);
  }

  .password__submit:focus-visible {
    outline: 1px solid var(--password-ink);
    outline-offset: 2px;
  }

  /* Errors sit under the rule; success replaces the field on its line. */
  .password__message {
    margin: 0;
  }

  .password__message[role='alert'] {
    margin-top: 4px;
    padding-left: 52px;
  }

  .password__message :is(ul, li) {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media (max-width: 700px) {
    .password__panel {
      padding: 24px 20px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .password__input {
      transition-duration: 1ms;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.password",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image",
      "info": "Fills the page, seen through the yellow inversion. Without one, the background is inverted instead."
    }
  ]
}
{% endschema %}
