{% comment %}
  All collections (/collections): the shop's grid, one card per collection,
  laid out and set as the product cards are (the Figma's 365 × 501 frame,
  then the title and a quiet product count on 19px lines). Like the shop,
  the design is just the grid; the heading is for assistive technology.

  https://shopify.dev/docs/storefronts/themes/architecture/templates/list-collections
{% endcomment %}

<div class="collections full-width">
  <h1 class="collections__sr">{{ 'collections.title' | t }}</h1>

  <ul class="collections__grid">
    {%- for collection in collections -%}
      {%- liquid
        # A collection without its own image shows its first product's.
        assign image = collection.featured_image | default: collection.products.first.featured_media.preview_image
        assign loading = 'lazy'
        if forloop.index <= 3
          assign loading = 'eager'
        endif
      -%}
      <li>
        <a class="collections__card" href="{{ collection.url }}">
          <div class="collections__media">
            {%- if image -%}
              {{
                image
                | image_url: width: 1200
                | image_tag:
                  class: 'collections__img',
                  widths: '240, 360, 480, 640, 800, 960, 1200',
                  sizes: '(min-width: 701px) calc((100vw - 185px) / 3), calc((100vw - 48px) / 2)',
                  loading: loading,
                  alt: ''
              }}
            {%- else -%}
              {% render 'media-placeholder' %}
            {%- endif -%}
          </div>
          <div class="collections__meta">
            <p class="collections__title">{{ collection.title | escape }}</p>
            <p class="collections__count">
              {{- collection.products_count }}
              {{ collection.products_count | pluralize: 'item', 'items' -}}
            </p>
          </div>
        </a>
      </li>
    {%- endfor -%}
  </ul>
</div>

{% stylesheet %}
  /* Spacing and type follow the shop grid (collection.liquid) and the product
     card (product-card.liquid), so the two pages read as one. */
  .collections {
    /* 64%: the least that keeps quiet text at 4.5:1 with the default colours. */
    --collections-quiet: color-mix(in srgb, var(--color-foreground) 64%, var(--color-background));
    --collections-gutter: 62.5px;
    --collections-cols: 3;

    padding: 7px var(--collections-gutter) 2px;
  }

  .collections__sr {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
    border: 0;
  }

  .collections__grid {
    display: grid;
    grid-template-columns: repeat(var(--collections-cols), minmax(0, 1fr));
    column-gap: 30px;
    row-gap: 37px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .collections__card {
    display: block;
    color: inherit;
    text-decoration: none;
  }

  .collections__card:focus-visible {
    outline: 1px solid var(--color-foreground);
    outline-offset: 2px;
  }

  .collections__media {
    aspect-ratio: 365 / 501;
    background-color: color-mix(in srgb, var(--color-background) 80%, var(--color-foreground));
  }

  .collections__img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .collections__meta {
    display: grid;
    min-width: 0;
    padding-top: 14px;
    color: #fff;
    font-family: var(--font-secondary--family);
    font-weight: 400;
  }

  .collections__title,
  .collections__count {
    margin: 0;
    font-size: 11px;
    line-height: 19px;
  }

  .collections__title {
    letter-spacing: -0.05em;
  }

  .collections__card:hover .collections__title {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
  }

  .collections__count {
    color: var(--collections-quiet);
    font-variant-numeric: tabular-nums;
  }

  @media (max-width: 700px) {
    /* Matches the header's own 20px inset at this width. */
    .collections {
      --collections-gutter: 20px;
      --collections-cols: 2;
    }

    .collections__grid {
      column-gap: 8px;
      row-gap: 32px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.collections_grid",
  "settings": [],
  "presets": [{ "name": "t:general.collections_grid" }]
}
{% endschema %}
