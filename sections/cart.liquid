{% comment %}
  Cart page: line items as compact product records (image · product · total,
  with quantity and remove beneath) beside a summary on the site's PDP/footer
  split, so subtotal and checkout sit on the footer's column.

  Commerce is the standard Shopify cart form: quantities post as `updates[]`
  to /cart, checkout is the form's `checkout` submit, and remove uses each
  line's own `url_to_remove`. With JavaScript, − / + and typed quantities
  change one line through the Ajax /cart/change.js endpoint instead, which
  (unlike the form's update) validates inventory; without JS the quantity is
  typed and applied with the Update button.

  https://shopify.dev/docs/storefronts/themes/architecture/templates/cart
{% endcomment %}

<div
  class="cart full-width"
  data-cart
  data-cart-url="{{ routes.cart_url }}"
  data-change-url="{{ routes.cart_change_url }}"
>
  <div class="cart__head">
    <h1 class="cart__title">{{ 'cart.title' | t }}</h1>
    {%- if cart.item_count > 0 -%}
      <p class="cart__count">
        {{ cart.item_count }}
        {% if cart.item_count == 1 %}item{% else %}items{% endif %}
      </p>
    {%- endif -%}
  </div>

  {%- if cart.item_count > 0 -%}
    <form class="cart__form" action="{{ routes.cart_url }}" method="post" data-cart-form>
      <ul class="cart__items">
        {%- for item in cart.items -%}
          <li class="cart__item" data-cart-line="{{ item.key }}">
            <a class="cart__image" href="{{ item.url }}" tabindex="-1" aria-hidden="true">
              {%- if item.image -%}
                {%- liquid
                  assign loading = 'lazy'
                  if forloop.index <= 3
                    assign loading = 'eager'
                  endif
                -%}
                {{
                  item.image
                  | image_url: width: 300
                  | image_tag:
                    widths: '80, 100, 160, 200, 300',
                    sizes: '(min-width: 768px) 100px, 80px',
                    loading: loading,
                    alt: ''
                }}
              {%- else -%}
                {{ 'product-apparel-1' | placeholder_svg_tag: 'cart__placeholder' }}
              {%- endif -%}
            </a>

            <div class="cart__info">
              <a class="cart__name" href="{{ item.url }}">{{ item.product.title }}</a>

              {%- unless item.product.has_only_default_variant -%}
                <dl class="cart__meta">
                  {%- for option in item.options_with_values -%}
                    <div class="cart__meta-row">
                      <dt>{{ option.name }}</dt>
                      <dd>{{ option.value }}</dd>
                    </div>
                  {%- endfor -%}
                </dl>
              {%- endunless -%}

              {%- if item.selling_plan_allocation -%}
                <p class="cart__note">{{ item.selling_plan_allocation.selling_plan.name }}</p>
              {%- endif -%}

              {%- for property in item.properties -%}
                {%- assign first_char = property.first | slice: 0 -%}
                {%- if property.last != blank and first_char != '_' -%}
                  <p class="cart__note">{{ property.first }}: {{ property.last }}</p>
                {%- endif -%}
              {%- endfor -%}

              {%- comment -%} At quantity 1 the unit price is the line total, shown once. {%- endcomment -%}
              {%- if item.quantity > 1 -%}
                <p class="cart__unit">{{ item.final_price | money_without_trailing_zeros }} each</p>
              {%- endif -%}

              {%- for allocation in item.line_level_discount_allocations -%}
                <p class="cart__note">
                  {{ allocation.discount_application.title }} (−{{ allocation.amount | money_without_trailing_zeros }})
                </p>
              {%- endfor -%}
            </div>

            <div class="cart__qty">
              {%- assign step = item.variant.quantity_rule.increment | default: 1 -%}
              <button
                class="cart__qty-btn"
                type="button"
                data-cart-step="-{{ step }}"
                aria-label="Decrease quantity of {{ item.product.title | escape }}"
              >
                <span aria-hidden="true">−</span>
              </button>
              <label class="cart__sr" for="Quantity-{{ forloop.index }}">
                Quantity of {{ item.product.title | escape }}
              </label>
              <input
                class="cart__qty-input"
                type="number"
                id="Quantity-{{ forloop.index }}"
                name="updates[]"
                value="{{ item.quantity }}"
                min="0"
                step="{{ step }}"
                {% if item.variant.quantity_rule.max %}
                  max="{{ item.variant.quantity_rule.max }}"
                {% endif %}
                inputmode="numeric"
                data-cart-qty
              >
              <button
                class="cart__qty-btn"
                type="button"
                data-cart-step="{{ step }}"
                aria-label="Increase quantity of {{ item.product.title | escape }}"
              >
                <span aria-hidden="true">+</span>
              </button>
            </div>

            <p class="cart__total">
              <span class="cart__sr">Total</span>
              {%- if item.original_line_price != item.final_line_price -%}
                <s class="cart__was">
                  <span class="cart__sr">Regular price</span>
                  {{ item.original_line_price | money_without_trailing_zeros }}
                </s>
              {%- endif -%}
              <span>{{ item.final_line_price | money_without_trailing_zeros }}</span>
            </p>

            <a class="cart__remove" href="{{ item.url_to_remove }}">
              {{ 'cart.remove' | t }}<span class="cart__sr"> {{ item.product.title }}</span>
            </a>
          </li>
        {%- endfor -%}
      </ul>

      {%- comment -%} Announces Shopify's response to a quantity change; the visible copy sits on the line itself. {%- endcomment -%}
      <p class="cart__sr" aria-live="polite" data-cart-live></p>

      <div class="cart__summary">
        {%- comment -%}
          First submit in the form, so pressing Enter in a quantity field updates
          rather than checks out. Hidden once JS applies quantities on change.
        {%- endcomment -%}
        <button class="cart__update" type="submit" name="update" data-cart-update>{{ 'cart.update' | t }}</button>

        {%- for discount in cart.cart_level_discount_applications -%}
          <p class="cart__summary-row cart__summary-row--discount">
            <span>{{ discount.title }}</span>
            <span>−{{ discount.total_allocated_amount | money_without_trailing_zeros }}</span>
          </p>
        {%- endfor -%}

        <p class="cart__summary-row cart__subtotal">
          <span>Subtotal</span>
          <span>{{ cart.total_price | money_without_trailing_zeros }}</span>
        </p>

        <p class="cart__tax">
          {%- if cart.taxes_included -%}
            Taxes included. Shipping calculated at checkout.
          {%- else -%}
            Taxes and shipping calculated at checkout.
          {%- endif -%}
        </p>

        <button class="cart__checkout" type="submit" name="checkout">{{ 'cart.checkout' | t }}</button>
      </div>
    </form>
  {%- else -%}
    <div class="cart__empty">
      <p>Your cart is empty.</p>
      <a class="cart__continue" href="{{ routes.all_products_collection_url }}">Shop</a>
    </div>
  {%- endif -%}
</div>

{% stylesheet %}
  /* The footer follows <main>; letting <main> take the body's spare height
     keeps it at the bottom of a short or empty cart. Long carts are unaffected. */
  body:has(.cart) > main {
    flex: 1 0 auto;
  }

  /* Set like the PDP and information pages: Assistant 11/15 throughout, with
     hierarchy from placement and hairlines rather than size or weight. */
  .cart {
    /* White, like the PDP, collection and information pages; the theme's
       foreground is the header's grey. */
    --cart-ink: #fff;
    /* 64%: the least that keeps quiet text at 4.5:1 with the default colours. */
    --cart-quiet: color-mix(in srgb, var(--color-foreground) 64%, var(--color-background));
    /* The PDP's and footer's hairline. */
    --cart-hairline: color-mix(in srgb, var(--cart-ink) 24%, transparent);
    --cart-plate: color-mix(in srgb, var(--color-background) 80%, var(--color-foreground));
    --cart-line: 15px;
    --cart-thumb: 100px;
    --cart-item-gap: 20px;

    /* As on the information pages: the first line sits 5px under the header. */
    padding: 5px var(--split-gutter) 0;
    color: var(--cart-ink);
    font-family: var(--font-secondary--family);
    font-size: 11px;
    font-weight: 400;
    line-height: var(--cart-line);
    letter-spacing: -0.05em;
  }

  .cart__sr {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
    border: 0;
  }

  .cart :is(a, button, input):focus-visible {
    outline: 1px solid var(--cart-ink);
    outline-offset: 2px;
  }

  .cart p {
    margin: 0;
  }

  /* --- Heading ---------------------------------------------------------- */

  .cart__head {
    display: flex;
    align-items: baseline;
    gap: var(--cart-item-gap);
    padding-bottom: var(--cart-line);
    border-bottom: 1px solid var(--cart-hairline);
  }

  /* A real h1, set in the page's own voice like the information pages' titles. */
  .cart__title {
    margin: 0;
    font: inherit;
    letter-spacing: inherit;
    text-transform: uppercase;
  }

  .cart__count {
    color: var(--cart-quiet);
    font-variant-numeric: tabular-nums;
  }

  /* --- Line items: image beside the record, controls along its foot -------- */

  .cart__items {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .cart__item {
    display: grid;
    grid-template-columns: var(--cart-thumb) minmax(0, 1fr) auto;
    grid-template-rows: auto 1fr;
    grid-template-areas:
      'image info total'
      'image qty remove';
    column-gap: var(--cart-item-gap);
    row-gap: var(--cart-line);
    padding: var(--cart-line) 0;
    border-bottom: 1px solid var(--cart-hairline);
  }

  .cart__image {
    grid-area: image;
    align-self: start;
    display: block;
    background-color: var(--cart-plate);
  }

  /* Natural proportions: garments are never cropped. The image's own width and
     height attributes reserve its box before it loads. */
  .cart__image img,
  .cart__placeholder {
    display: block;
    width: 100%;
    height: auto;
  }

  .cart__placeholder {
    aspect-ratio: 2 / 3;
    fill: var(--cart-quiet);
  }

  .cart__info {
    grid-area: info;
    display: grid;
    align-content: start;
    min-width: 0;
    overflow-wrap: anywhere;
  }

  .cart__name {
    justify-self: start;
    color: inherit;
    text-decoration: none;
  }

  .cart__name:hover {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 2px;
  }

  .cart__meta {
    margin: 0;
  }

  .cart__meta-row {
    display: flex;
    gap: 0.6em;
  }

  .cart__meta dt {
    color: var(--cart-quiet);
  }

  .cart__meta dd {
    margin: 0;
    font-variant-numeric: tabular-nums;
  }

  .cart__unit,
  .cart__note {
    color: var(--cart-quiet);
    font-variant-numeric: tabular-nums;
  }

  /* Shopify's own message when it refuses a quantity, shown on that line. */
  .cart__line-msg {
    color: var(--cart-ink);
  }

  .cart__total {
    grid-area: total;
    display: grid;
    justify-items: end;
    text-align: right;
    font-variant-numeric: tabular-nums;
  }

  .cart__was {
    color: var(--cart-quiet);
  }

  /* − 1 +, set as text like the PDP's quantity. Each control is a 24 × 27 box
     (larger than its glyph, never shifting it); the negative margins keep the
     row on one 15px line and the − glyph on the record's left edge. */
  .cart__qty {
    grid-area: qty;
    align-self: end;
    justify-self: start;
    display: flex;
    align-items: center;
    margin: -6px 0 -6px -9px;
  }

  .cart__qty-btn,
  .cart__qty-input {
    height: 27px;
    padding: 0;
    border: 0;
    border-radius: 0;
    background: none;
    color: inherit;
    font: inherit;
    letter-spacing: inherit;
  }

  .cart__qty-btn {
    width: 24px;
    cursor: pointer;
  }

  .cart__qty-input {
    width: 2.5em;
    text-align: center;
    font-variant-numeric: tabular-nums;
    appearance: textfield;
    -moz-appearance: textfield;
  }

  .cart__qty-input::-webkit-inner-spin-button,
  .cart__qty-input::-webkit-outer-spin-button {
    -webkit-appearance: none;
    margin: 0;
  }

  /* The steppers need JS; without it the number is typed and applied with Update. */
  .cart:not(.is-enhanced) .cart__qty-btn {
    visibility: hidden;
  }

  /* Text links and text buttons share one treatment; the padding and negative
     margin grow the hit area to 27px without moving the text. */
  .cart__remove,
  .cart__update,
  .cart__continue {
    padding: 6px 0;
    margin: -6px 0;
    color: var(--cart-quiet);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 2px;
  }

  .cart__remove:hover,
  .cart__update:hover,
  .cart__continue:hover {
    color: var(--cart-ink);
  }

  .cart__remove {
    grid-area: remove;
    align-self: end;
    justify-self: end;
  }

  /* --- Summary and checkout ---------------------------------------------- */

  .cart__summary {
    display: grid;
    align-content: start;
    padding-top: var(--cart-line);
  }

  .cart__update {
    justify-self: start;
    margin-bottom: calc(var(--cart-line) - 6px);
    border: 0;
    background: none;
    font: inherit;
    letter-spacing: inherit;
    cursor: pointer;
  }

  .cart.is-enhanced .cart__update {
    display: none;
  }

  .cart__summary-row {
    display: flex;
    justify-content: space-between;
    gap: var(--cart-item-gap);
    font-variant-numeric: tabular-nums;
  }

  .cart__summary-row--discount,
  .cart__tax {
    color: var(--cart-quiet);
  }

  /* The PDP's Add to Cart capsule: 19px tall and kept thin on purpose, with the
     hit area grown invisibly instead. */
  .cart__checkout {
    position: relative;
    display: block;
    width: 100%;
    height: 19px;
    margin-top: 21px;
    padding: 0 1rem;
    border: 1px solid var(--cart-hairline);
    border-radius: 9.5px;
    background: none;
    color: inherit;
    font: inherit;
    line-height: 12px;
    letter-spacing: inherit;
    cursor: pointer;
    transition: border-color 200ms ease;
  }

  .cart__checkout::before {
    content: '';
    position: absolute;
    inset: -12px -1px;
  }

  .cart__checkout:hover {
    border-color: var(--cart-ink);
  }

  /* --- Empty ------------------------------------------------------------- */

  .cart__empty {
    display: grid;
    justify-items: start;
    padding-top: var(--cart-line);
  }

  .cart__continue {
    margin-top: calc(var(--cart-line) - 6px);
  }

  /* --- Two columns: items · summary, on the PDP/footer split --------------- */

  @media (min-width: 768px) {
    .cart {
      display: grid;
      grid-template-columns: var(--split-columns);
      grid-template-rows: auto 1fr;
      column-gap: var(--split-gap);
      align-items: start;
      /* As the footer: past ~1920px the composition stops widening and centres. */
      width: 100%;
      max-width: calc(var(--split-max) + 2 * var(--split-gutter));
      margin-inline: auto;
    }

    .cart__head,
    .cart__items,
    .cart__empty {
      grid-column: 1;
    }

    /* The form adds no box, so the items and summary sit on the cart's grid. */
    .cart__form {
      display: contents;
    }

    /* Its rule continues the heading's across the split, and the subtotal
       lines up with the first item. */
    .cart__summary {
      grid-column: 2;
      grid-row: 2;
      /* Overlaps the heading's rule rather than drawing a second one under it. */
      margin-top: -1px;
      border-top: 1px solid var(--cart-hairline);
    }
  }

  @media (max-width: 700px) {
    /* The header's own 20px inset at this width, as on the information pages. */
    .cart {
      --cart-thumb: 80px;
      --cart-item-gap: 15px;

      padding-top: 20px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cart *,
    .cart *::before,
    .cart *::after {
      transition-duration: 1ms !important;
    }
  }
{% endstylesheet %}

{% javascript %}
  (function () {
    'use strict';

    // Carries Shopify's message and the shopper's focus across the reload that
    // follows a change.
    var FLASH = 'cart:flash';

    function readFlash() {
      try {
        var raw = sessionStorage.getItem(FLASH);
        sessionStorage.removeItem(FLASH);
        return raw ? JSON.parse(raw) : null;
      } catch (e) {
        return null;
      }
    }

    function writeFlash(flash) {
      try {
        sessionStorage.setItem(FLASH, JSON.stringify(flash));
      } catch (e) {
        /* storage unavailable: the reload still shows the correct cart */
      }
    }

    function postJSON(url, body) {
      return fetch(url, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
        body: JSON.stringify(body)
      });
    }

    // With JS, each quantity change goes to /cart/change.js for its own line
    // (by line key), which validates inventory; the updates[] form remains the
    // no-JS path and the fallback if the request itself fails.
    function init(root) {
      if (root.dataset.cartReady === 'true') return;
      var form = root.querySelector('[data-cart-form]');
      var update = root.querySelector('[data-cart-update]');
      if (!form || !update) return;
      root.dataset.cartReady = 'true';
      root.classList.add('is-enhanced');

      var live = root.querySelector('[data-cart-live]');
      var changeUrl = root.dataset.changeUrl + '.js';
      var cartUrl = root.dataset.cartUrl + '.js';
      var busy = false;

      function lineFor(key) {
        var lines = root.querySelectorAll('[data-cart-line]');
        for (var i = 0; i < lines.length; i++) {
          if (lines[i].dataset.cartLine === key) return lines[i];
        }
        return null;
      }

      function showMessage(line, text) {
        if (!line || !text) return;
        var info = line.querySelector('.cart__info');
        var msg = info.querySelector('.cart__line-msg');
        if (!msg) {
          msg = document.createElement('p');
          msg.className = 'cart__line-msg';
          info.appendChild(msg);
        }
        msg.textContent = text;
        if (live) live.textContent = text;
      }

      function control(line, which) {
        if (!line) return null;
        if (which === 'input') return line.querySelector('[data-cart-qty]');
        return line.querySelector(which === 'minus' ? '[data-cart-step^="-"]' : '[data-cart-step]:not([data-cart-step^="-"])');
      }

      function reload(flash) {
        writeFlash(flash);
        window.location.reload();
      }

      function change(line, quantity, which) {
        if (busy) return;
        busy = true;
        line.setAttribute('aria-busy', 'true');
        var key = line.dataset.cartLine;
        var input = line.querySelector('[data-cart-qty]');
        var shown = Number(input.defaultValue);

        postJSON(changeUrl, { id: key, quantity: quantity })
          .then(function (response) {
            if (response.ok) return reload({ key: key, focus: which });
            return response.json().then(function (error) {
              var message = error.description || error.message;
              // A refused change may still have been capped, so ask Shopify
              // what this line now holds rather than assuming.
              return fetch(cartUrl, { headers: { Accept: 'application/json' } })
                .then(function (r) { return r.json(); })
                .then(function (cart) {
                  var item = cart.items.filter(function (i) { return i.key === key; })[0];
                  var kept = item ? item.quantity : 0;
                  if (kept !== shown) return reload({ key: key, focus: which, message: message });
                  input.value = shown;
                  busy = false;
                  line.removeAttribute('aria-busy');
                  showMessage(line, message);
                });
            });
          })
          .catch(function () {
            // Network or parse failure: fall back to the standard form update.
            input.value = quantity;
            if (form.requestSubmit) form.requestSubmit(update);
            else update.click();
          });
      }

      root.querySelectorAll('[data-cart-step]').forEach(function (button) {
        button.addEventListener('click', function () {
          var line = button.closest('[data-cart-line]');
          var input = line.querySelector('[data-cart-qty]');
          var step = Number(button.dataset.cartStep) || 0;
          var next = Math.max(0, (Number(input.value) || 0) + step);
          // Merchant quantity rule only; stock limits are Shopify's to enforce.
          if (input.max && next > Number(input.max)) next = Number(input.max);
          input.value = next;
          change(line, next, step < 0 ? 'minus' : 'plus');
        });
      });

      root.querySelectorAll('[data-cart-qty]').forEach(function (input) {
        function commit() {
          var next = Math.max(0, Math.floor(Number(input.value)) || 0);
          if (next === Number(input.defaultValue)) return;
          change(input.closest('[data-cart-line]'), next, 'input');
        }
        input.addEventListener('change', commit);
        input.addEventListener('keydown', function (event) {
          if (event.key === 'Enter') {
            event.preventDefault();
            commit();
          }
        });
      });

      // After a reload: return focus to the control that was used, and show
      // Shopify's message on that line if there was one.
      var flash = readFlash();
      if (flash) {
        var line = lineFor(flash.key);
        var target = control(line, flash.focus);
        if (target) target.focus({ preventScroll: false });
        if (flash.message) {
          // Let the live region settle before filling it so it is announced.
          setTimeout(function () { showMessage(line, flash.message); }, 150);
        }
      }
    }

    function initAll(scope) {
      (scope || document).querySelectorAll('[data-cart]').forEach(init);
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', function () { initAll(); });
    } else {
      initAll();
    }

    document.addEventListener('shopify:section:load', function (event) {
      initAll(event.target);
    });
  })();
{% endjavascript %}

{% schema %}
{
  "name": "t:general.cart",
  "settings": []
}
{% endschema %}
