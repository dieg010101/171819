{% comment %}
  Product detail page: a column of product media · product information.

  Everything commerce-critical is server-rendered. The form is a plain Shopify
  product form posting to /cart/add; its `name="id"` <select> is the source of
  truth for the submitted variant. JavaScript only adds the option buttons'
  behaviour, keeps that select in sync, and updates price/availability/media.
  Without JS the select itself is shown (see the <noscript> styles below).

  https://shopify.dev/docs/storefronts/themes/architecture/templates/product
{% endcomment %}

{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign media_count = product.media.size

  # Open on the selected variant's own media when it has one.
  assign active_media = product.featured_media
  if current_variant.featured_media
    assign active_media = current_variant.featured_media
  endif

  assign form_id = 'ProductForm-' | append: section.id
  assign status_label = 'Available'
  if current_variant.available == false
    assign status_label = 'Sold out'
  endif

  # Size guide seam. The guide is normalised to the shape
  # snippets/product-size-guide.liquid documents: the unit the values are
  # authored in, column labels (independent of the variant options), measurement
  # names, and a flat row-by-row list of values.
  #
  # Priority: 1. exactly one valid size guide assigned to this product; 2. the
  # design-preview sample, only when the section's "preview_size_guide" setting
  # is on AND no guide is assigned; 3. nothing, in which case the Size Guide
  # control is not rendered. A product in more than one guide, or assigned to a
  # malformed guide, renders nothing, not even the sample: no measurements beat
  # possibly wrong ones.
  assign size_guide_unit = 'cm'
  assign size_guide_sizes = '' | split: ','
  assign size_guide_rows = '' | split: ','
  assign size_guide_values = '' | split: ','
  assign size_guide_note = ''

  # Size guide resolver. Guides are Sanity "sizeGuide" documents that Sanity
  # Connect syncs as metaobjects of the type below, each with `products` (a
  # list of Product references) and `data` (JSON: sizes[], measurements[] of
  # { label, values[] } in centimetres, note). The guide owns the relationship,
  # so this product's guide is found by checking each guide's products by
  # product ID. If Shopify reports a different type, change it here only.
  #
  # The current resolver is intended for a small number of Size Guides. If the
  # catalog grows to more than roughly the unpaginated Liquid metaobject lookup
  # can safely cover (Shopify loops over at most 50 entries of a definition),
  # replace this resolver with a direct indexed Product → Size Guide lookup.
  assign size_guide_type = 'app--6007307--sanity-documents-sizeGuide'
  assign size_guide_matches = 0
  assign size_guide_entry = nil
  for guide in metaobjects[size_guide_type].values
    for assigned in guide.products.value
      if assigned.id == product.id
        assign size_guide_matches = size_guide_matches | plus: 1
        assign size_guide_entry = guide
        break
      endif
    endfor
    # Two matches already make it ambiguous; no need to look further.
    if size_guide_matches > 1
      break
    endif
  endfor

  # Studio validation guarantees this shape; check it anyway, since the values
  # are laid out row by row and one short row would shift every later value.
  assign size_guide_invalid = false
  if size_guide_matches > 1
    assign size_guide_invalid = true
  elsif size_guide_matches == 1
    assign size_guide_data = size_guide_entry.data.value
    assign guide_sizes = size_guide_data.sizes
    assign guide_measurements = size_guide_data.measurements
    if guide_sizes == blank or guide_measurements == blank
      assign size_guide_invalid = true
    endif
    for measurement in guide_measurements
      if measurement.label == blank or measurement.values.size != guide_sizes.size
        assign size_guide_invalid = true
      endif
      for value in measurement.values
        assign number = value | plus: 0
        if value == blank or number <= 0
          assign size_guide_invalid = true
        endif
      endfor
    endfor

    if size_guide_invalid == false
      assign size_guide_sizes = guide_sizes
      assign size_guide_rows = guide_measurements | map: 'label'
      for measurement in guide_measurements
        assign size_guide_values = size_guide_values | concat: measurement.values
      endfor
      assign size_guide_note = size_guide_data.note
    endif
  endif

  assign has_size_guide = false
  if size_guide_sizes.size > 0 and size_guide_rows.size > 0
    assign has_size_guide = true
  endif

  # TEMPORARY, design preview only: the Figma's example measurements, so the
  # Size Guide can be seen in the theme editor before real data exists. Never
  # product data, and never shown over a real or an ambiguous guide. Remove with
  # the setting once real guides are live.
  if has_size_guide == false and size_guide_invalid == false and section.settings.preview_size_guide
    assign size_guide_unit = 'cm'
    assign size_guide_sizes = 'S,M,L,XL,XXL' | split: ','
    assign size_guide_rows = 'Length,Waist,Thigh,Leg Opening,Front Rise,Back Rise' | split: ','
    assign sample_row = '70,71.5,73,74.5,76' | split: ','
    assign size_guide_values = sample_row
    for row in (2..6)
      assign size_guide_values = size_guide_values | concat: sample_row
    endfor
    assign size_guide_note = 'Measurements taken with garment laid flat.'
    assign has_size_guide = true
  endif
-%}

<div class="pdp full-width" data-pdp>
  <div class="pdp__grid">
    {%- comment -%} Media: one list of slides; CSS decides between a vertical column (desktop) and a swipeable scroll-snap track (phone). {%- endcomment -%}
    <div class="pdp__media">
      <ul class="pdp__slides" data-pdp-slides aria-label="Product media">
        {%- for media in product.media -%}
          {%- liquid
            assign is_active = false
            if media.id == active_media.id
              assign is_active = true
            endif
            assign alt = media.alt | default: product.title
          -%}
          <li
            class="pdp__slide{% if is_active %} is-active{% endif %}"
            data-pdp-slide
            data-media-id="{{ media.id }}"
            aria-label="{{ forloop.index }} of {{ media_count }}"
          >
            {%- case media.media_type -%}
              {%- when 'video' -%}
                {{ media | video_tag: image_size: '1400x', controls: true, class: 'pdp__media-el' }}
              {%- when 'external_video' -%}
                {{ media | external_video_tag: class: 'pdp__media-el' }}
              {%- else -%}
                {%- comment -%}
                  Images, and the preview image of 3D models (this theme has no model viewer).
                  The first media leads the desktop column and the active one leads the phone track,
                  so both load eagerly.
                {%- endcomment -%}
                {%- liquid
                  assign loading = 'lazy'
                  assign priority = 'auto'
                  if forloop.first or is_active
                    assign loading = 'eager'
                  endif
                  if forloop.first
                    assign priority = 'high'
                  endif
                -%}
                {{
                  media.preview_image
                  | image_url: width: 1600
                  | image_tag:
                    class: 'pdp__media-el',
                    widths: '400, 560, 720, 900, 1100, 1300, 1600',
                    sizes: '(min-width: 768px) 46vw, calc(100vw - 40px)',
                    loading: loading,
                    fetchpriority: priority,
                    alt: alt
                }}
            {%- endcase -%}
          </li>
        {%- else -%}
          <li class="pdp__slide is-active" data-pdp-slide>
            {{ 'product-apparel-1' | placeholder_svg_tag: 'pdp__media-el pdp__placeholder' }}
          </li>
        {%- endfor -%}
      </ul>

      {%- if media_count > 1 -%}
        <p class="pdp__index" aria-hidden="true">
          <span data-pdp-index>
            {%- for media in product.media -%}
              {%- if media.id == active_media.id -%}{{ forloop.index | prepend: '0' | slice: -2, 2 }}{%- endif -%}
            {%- endfor -%}
          </span>
          <span class="pdp__index-sep">/</span>
          {{ media_count | prepend: '0' | slice: -2, 2 }}
        </p>
      {%- endif -%}
    </div>

    <div class="pdp__info">
      <h1 class="pdp__title">{{ product.title }}</h1>

      <div class="pdp__buy-row">
        <p class="pdp__price">
          <span class="pdp__sr" data-pdp-price-label>
            {%- if current_variant.compare_at_price > current_variant.price -%}Sale price{%- else -%}Price{%- endif -%}
          </span>
          <span data-pdp-price>{{ current_variant.price | money_with_currency }}</span>
          <s class="pdp__compare" data-pdp-compare {% unless current_variant.compare_at_price > current_variant.price %}hidden{% endunless %}>
            <span class="pdp__sr">Regular price</span>
            <span data-pdp-compare-value>{{ current_variant.compare_at_price | money }}</span>
          </s>
        </p>

        {%- comment -%} Lives beside the price, outside the form; `form` still submits it with the product form. {%- endcomment -%}
        <div class="pdp__qty">
          <label class="pdp__qty-label" for="Quantity-{{ section.id }}">Quantity</label>
          <input
            class="pdp__qty-input"
            type="number"
            id="Quantity-{{ section.id }}"
            name="quantity"
            form="{{ form_id }}"
            min="1"
            value="1"
            inputmode="numeric"
            data-pdp-qty-input
          >
          <button class="pdp__qty-btn" type="button" data-pdp-qty="-1" aria-label="Decrease quantity">
            <span aria-hidden="true">-</span>
          </button>
          <button class="pdp__qty-btn" type="button" data-pdp-qty="1" aria-label="Increase quantity">
            <span aria-hidden="true">+</span>
          </button>
        </div>
      </div>
      {%- comment -%} Availability is carried by the button and the option states; this keeps it in text for assistive tech. {%- endcomment -%}
      <p class="pdp__sr" data-pdp-status>{{ status_label }}</p>

      {%- unless product.has_only_default_variant -%}
        <div class="pdp__options">
          {%- for option in product.options_with_values -%}
            {%- assign option_index = forloop.index0 -%}
            <fieldset class="pdp__option" data-pdp-option>
              <legend class="pdp__sr">{{ option.name }}</legend>
              <div class="pdp__values">
                {%- for value in option.values -%}
                  {%- liquid
                    assign value_id = 'Option-' | append: section.id | append: '-' | append: option_index | append: '-' | append: forloop.index0
                    assign state = 'available'
                    if value.variant == blank
                      assign state = 'unavailable'
                    elsif value.available == false
                      assign state = 'soldout'
                    endif
                  -%}
                  <input
                    class="pdp__value-input"
                    type="radio"
                    id="{{ value_id }}"
                    name="Option-{{ section.id }}-{{ option_index }}"
                    value="{{ value | escape }}"
                    {% if value.selected %}
                      checked
                    {% endif %}
                  >
                  <label class="pdp__value" for="{{ value_id }}" data-state="{{ state }}">
                    <span class="pdp__value-text">{{ value }}</span>
                    <span class="pdp__sr" data-pdp-value-state>
                      {%- if state == 'soldout' -%}, sold out{%- elsif state == 'unavailable' -%}, unavailable{%- endif -%}
                    </span>
                  </label>
                {%- endfor -%}
              </div>
            </fieldset>
          {%- endfor -%}
        </div>
      {%- endunless -%}

      {%- form 'product', product, id: form_id, class: 'pdp__form' -%}
        <div class="pdp__variant-fallback{% if product.has_only_default_variant %} pdp__variant-fallback--default{% endif %}">
          <label class="pdp__sr" for="Variant-{{ section.id }}">{{ product.options.first | default: 'Option' }}</label>
          <select class="pdp__select" id="Variant-{{ section.id }}" name="id" data-pdp-variant-select>
            {%- for variant in product.variants -%}
              <option
                value="{{ variant.id }}"
                {% if variant == current_variant %}
                  selected="selected"
                {% endif %}
                {% unless variant.available %}
                  disabled
                {% endunless %}
              >
                {{ variant.title }} — {{ variant.price | money_with_currency }}
                {%- unless variant.available %} (sold out){% endunless -%}
              </option>
            {%- endfor -%}
          </select>
        </div>

        <button
          class="pdp__submit"
          type="submit"
          name="add"
          data-pdp-submit
          data-label-add="Add to Cart"
          data-label-soldout="Sold out"
          data-label-unavailable="Unavailable"
          {% unless current_variant.available %}
            disabled
          {% endunless %}
        >
          {%- if current_variant.available -%}Add to Cart{%- else -%}Sold out{%- endif -%}
        </button>

        {%- if section.settings.show_dynamic_checkout -%}
          <div class="pdp__dynamic" data-pdp-dynamic {% unless current_variant.available %}hidden{% endunless %}>
            {{ form | payment_button }}
          </div>
        {%- endif -%}
      {%- endform -%}

      {%- comment -%} Variant changes are announced once, here, rather than from every updated node. {%- endcomment -%}
      <p class="pdp__sr" aria-live="polite" data-pdp-live></p>

      {%- comment -%}
        Two disclosures share one slot under their row, so only one is open at a
        time. Each appears only when Shopify has content for it.
      {%- endcomment -%}
      {%- if product.description != blank or has_size_guide -%}
        <div class="pdp__notes" data-pdp-notes>
          <div class="pdp__toggles">
            {%- if product.description != blank -%}
              <button
                class="pdp__toggle"
                type="button"
                aria-expanded="false"
                aria-controls="PdpDescription-{{ section.id }}"
                data-pdp-toggle
              >
                <span>Item Description</span>
                <span class="pdp__toggle-icon" aria-hidden="true"></span>
              </button>
            {%- endif -%}
            {%- if has_size_guide -%}
              <button
                class="pdp__toggle pdp__toggle--end"
                type="button"
                aria-expanded="false"
                aria-controls="PdpSizeGuide-{{ section.id }}"
                data-pdp-toggle
              >
                <span>Size Guide</span>
                <span class="pdp__toggle-icon" aria-hidden="true"></span>
              </button>
            {%- endif -%}
          </div>

          {%- if product.description != blank -%}
            <div class="pdp__panel pdp__prose" id="PdpDescription-{{ section.id }}" data-pdp-panel hidden>
              {{ product.description }}
            </div>
          {%- endif -%}
          {%- if has_size_guide -%}
            <div class="pdp__panel pdp__panel--size-guide" id="PdpSizeGuide-{{ section.id }}" data-pdp-panel hidden>
              {%- render 'product-size-guide',
                unit: size_guide_unit,
                sizes: size_guide_sizes,
                rows: size_guide_rows,
                values: size_guide_values,
                note: size_guide_note
              -%}
            </div>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>
  </div>

  {%- comment -%} Minimal per-variant data for the enhancement; money is formatted here so JS never re-implements the store's money format. {%- endcomment -%}
  <script type="application/json" data-pdp-variants>
    [
      {%- for variant in product.variants -%}
        {
          "id": {{ variant.id }},
          "title": {{ variant.title | json }},
          "options": {{ variant.options | json }},
          "available": {{ variant.available | json }},
          "price": {{ variant.price | money_with_currency | json }},
          "compare": {% if variant.compare_at_price > variant.price %}{{ variant.compare_at_price | money | json }}{% else %}null{% endif %},
          "media": {{ variant.featured_media.id | json }}
        }{% unless forloop.last %},{% endunless %}
      {%- endfor -%}
    ]
  </script>
</div>

{%- comment -%} Without JS the option buttons cannot change the submitted variant, so the native select takes their place, all media is reachable by scrolling, and the disclosures are simply open. {%- endcomment -%}
<noscript>
  <style>
    .pdp .pdp__options,
    .pdp .pdp__index,
    .pdp .pdp__qty-btn,
    .pdp .pdp__toggle-icon { display: none; }
    .pdp .pdp__variant-fallback:not(.pdp__variant-fallback--default) { display: block; }
    .pdp .pdp__panel[hidden] { display: block; }
  </style>
</noscript>

{% stylesheet %}
  /*
    Geometry is derived from the 1280px Figma frame (64px gutters, a 554px media
    column, 125px of air, a 472px information column) and expressed as
    proportions so the same composition holds at other widths.
  */
  .pdp {
    --pdp-ink: #fff;
    --pdp-quiet: color-mix(in srgb, var(--pdp-ink) 42%, transparent);
    /* The Figma's 0.15px white rules, as they actually render on #1b1b1b. */
    --pdp-hairline: color-mix(in srgb, var(--pdp-ink) 24%, transparent);
    /* 554 × 615: the media frame in the Figma. */
    --pdp-frame: 554 / 615;
    --pdp-line: 30px;
    --pdp-ease: 200ms ease;

    /* With the header's 158px, puts the media top at the Figma's y = 168. The
       space below belongs to the site footer (--site-footer-gap). The gutter
       matches the header's inset, as on the collection and cart pages. */
    padding: 10px var(--split-gutter) 0;
    color: var(--pdp-ink);
    font-family: var(--font-secondary--family);
    font-size: 11px;
    line-height: var(--pdp-line);
  }

  .pdp__grid {
    display: grid;
    row-gap: 1.5rem;
  }

  .pdp__sr {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
    border: 0;
  }

  .pdp :is(a, button, select, input):focus-visible,
  .pdp__value-input:focus-visible + .pdp__value {
    outline: 1px solid var(--pdp-ink);
    outline-offset: 2px;
  }

  /* --- Media --------------------------------------------------------------- */

  .pdp__media {
    min-width: 0;
  }

  /* Phone: a native horizontal scroll-snap track. */
  .pdp__slides {
    display: flex;
    margin: 0;
    padding: 0;
    list-style: none;
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
  }

  .pdp__slides::-webkit-scrollbar {
    display: none;
  }

  .pdp__slide {
    flex: 0 0 100%;
    aspect-ratio: var(--pdp-frame);
    scroll-snap-align: start;
  }

  .pdp__media-el {
    display: block;
    width: 100%;
    height: 100%;
    /* The design fills the frame edge to edge, so off-ratio media is cropped. */
    object-fit: cover;
    border: 0;
  }

  .pdp__placeholder {
    fill: var(--pdp-quiet);
  }

  .pdp__index {
    margin: 0.5rem 0 0;
    font-size: 10px;
    line-height: 12px;
    font-variant-numeric: tabular-nums;
    color: var(--pdp-quiet);
  }

  .pdp__index-sep {
    margin: 0 0.3em;
  }

  /* --- Product information ------------------------------------------------ */

  .pdp__info {
    min-width: 0;
  }

  .pdp__title {
    margin: 0;
    font: inherit;
    letter-spacing: -0.05em;
  }

  .pdp__buy-row {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    column-gap: 1.5rem;
  }

  .pdp__price {
    margin: 0;
  }

  .pdp__compare {
    margin-left: 0.6em;
    color: var(--pdp-quiet);
  }

  /* Quantity · 1 · - · +, set as text; the spacing follows the Figma. */
  .pdp__qty {
    display: flex;
    align-items: baseline;
  }

  .pdp__qty-input {
    width: 20px;
    margin: 0 30px;
    padding: 0;
    border: 0;
    border-radius: 0;
    background: none;
    color: inherit;
    line-height: inherit;
    text-align: center;
    font-variant-numeric: tabular-nums;
    appearance: textfield;
    -moz-appearance: textfield;
  }

  .pdp__qty-input::-webkit-inner-spin-button,
  .pdp__qty-input::-webkit-outer-spin-button {
    -webkit-appearance: none;
    margin: 0;
  }

  .pdp__qty-btn + .pdp__qty-btn {
    margin-left: 23px;
  }

  /* Shared by every text-only control: a bare glyph with a larger, invisible
     hit area that never shifts the layout. */
  .pdp__qty-btn,
  .pdp__toggle {
    position: relative;
    padding: 0;
    border: 0;
    border-radius: 0;
    background: none;
    color: inherit;
    font: inherit;
    cursor: pointer;
  }

  .pdp__qty-btn::before,
  .pdp__toggle::before {
    content: '';
    position: absolute;
    inset: -8px -10px;
  }

  .pdp__qty-btn[aria-disabled='true'] {
    cursor: default;
  }

  /* Sizes: plain figures; the selected one carries a short rule beneath it. */
  .pdp__option {
    min-width: 0;
    margin: 0;
    padding: 0;
    border: 0;
  }

  .pdp__options {
    margin-top: 1px;
  }

  .pdp__values {
    display: flex;
    flex-wrap: wrap;
    column-gap: clamp(28px, 3.9vw, 50px);
  }

  .pdp__value-input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }

  .pdp__value {
    /* Grow the touch target without moving the figures. */
    padding: 7px 10px;
    margin: -7px -10px;
    font-variant-numeric: tabular-nums;
    cursor: pointer;
    transition: color var(--pdp-ease);
  }

  .pdp__value-text {
    position: relative;
    display: inline-block;
  }

  .pdp__value-text::after {
    content: '';
    position: absolute;
    inset: auto 0 1px;
    height: 1px;
    background-color: var(--pdp-hairline);
    opacity: 0;
    transition: opacity var(--pdp-ease);
  }

  .pdp__value:hover .pdp__value-text::after {
    opacity: 0.5;
  }

  .pdp__value-input:checked + .pdp__value .pdp__value-text::after {
    opacity: 1;
  }

  /* Sold out stays selectable (so its state can be read and announced), struck
     through; a combination with no variant at all is fainter still. */
  .pdp__value:is([data-state='soldout'], [data-state='unavailable']) {
    color: var(--pdp-quiet);
  }

  /* On the figure itself: decorations don't propagate into inline-blocks. */
  .pdp__value:is([data-state='soldout'], [data-state='unavailable']) .pdp__value-text {
    text-decoration: line-through;
    text-decoration-thickness: 1px;
  }

  .pdp__value[data-state='unavailable'] {
    opacity: 0.6;
  }

  .pdp__form {
    margin-top: 21px;
  }

  .pdp__variant-fallback {
    display: none;
  }

  .pdp__select {
    width: 100%;
    padding: 0.5rem;
    border: 1px solid var(--pdp-hairline);
    border-radius: 0;
    color: inherit;
  }

  /* The Figma's thin capsule: 19px tall, kept thin on purpose; the hit area
     is grown invisibly instead. */
  .pdp__submit {
    position: relative;
    display: block;
    width: 100%;
    height: 19px;
    padding: 0 1rem;
    border: 1px solid var(--pdp-hairline);
    border-radius: 9.5px;
    background: none;
    color: inherit;
    font: inherit;
    line-height: 12px;
    letter-spacing: -0.05em;
    cursor: pointer;
    transition: border-color var(--pdp-ease), color var(--pdp-ease);
  }

  .pdp__submit::before {
    content: '';
    position: absolute;
    inset: -12px -1px;
  }

  .pdp__submit:hover:not(:disabled) {
    border-color: var(--pdp-ink);
  }

  .pdp__submit:disabled {
    color: var(--pdp-quiet);
    cursor: not-allowed;
  }

  .pdp__dynamic {
    margin-top: 12px;
    --shopify-accelerated-checkout-button-block-size: 32px;
    --shopify-accelerated-checkout-button-border-radius: 16px;
  }

  /* --- Disclosures -------------------------------------------------------- */

  /* One grid for the row and its panels: the toggles sit at either end, and
     panels can align to them (the size guide's units sit under its toggle). */
  .pdp__notes {
    display: grid;
    grid-template-columns: max-content 1fr max-content;
    margin-top: 17px;
    font-size: 10px;
    line-height: 12px;
    letter-spacing: -0.05em;
  }

  .pdp__toggles {
    display: contents;
  }

  .pdp__toggle {
    display: inline-flex;
    gap: 56px;
    letter-spacing: inherit;
  }

  .pdp__toggle--end {
    grid-column: 3;
  }

  /* Text, not iconography: + when closed, - when open, as drawn. The fixed
     slot keeps the right-hand toggle's label still as the glyph changes. */
  .pdp__toggle-icon {
    display: inline-block;
    width: 5px;
    text-align: center;
  }

  .pdp__toggle-icon::before {
    content: '+';
  }

  .pdp__toggle[aria-expanded='true'] .pdp__toggle-icon::before {
    content: '-';
  }

  .pdp__panel {
    grid-column: 1 / -1;
    min-width: 0;
  }

  /* Description: the full column width, 11/12 like the Figma; Shopify's own
     paragraphs are separated by two empty lines. */
  .pdp__prose {
    margin-top: 23px;
    font-size: 11px;
    line-height: 12px;
    letter-spacing: -0.05em;
  }

  .pdp__prose > * + * {
    margin-top: 24px;
  }

  /* Size guide: the units take the toggle's column, so they start under
     "Size Guide"; the measurements end flush with the column. `hidden` must
     still win over the display. */
  .pdp__panel--size-guide:not([hidden]),
  .pdp__panel--size-guide .size-guide {
    display: grid;
    grid-template-columns: subgrid;
  }

  .pdp__panel--size-guide {
    margin-top: 14px;
  }

  .pdp__panel--size-guide .size-guide {
    grid-column: 1 / -1;
  }

  .pdp__panel--size-guide .size-guide__units {
    grid-column: 3;
    justify-self: start;
  }

  .pdp__panel--size-guide .size-guide__body {
    grid-column: 1 / -1;
    justify-self: end;
  }

  .pdp__prose :is(ul, ol) {
    padding-left: 1.1em;
  }

  .pdp__prose a {
    color: inherit;
    text-underline-offset: 2px;
  }

  /* --- Two columns: media · information ------------------------------------ */

  @media (min-width: 768px) {
    .pdp__grid {
      /* 554 : 472 with 125px between them at 1280px; the gap eases down with
         the viewport so tablet widths keep room for the information column. */
      grid-template-columns: var(--split-columns);
      column-gap: var(--split-gap);
      align-items: start;
      /* Past ~1920px the composition stops widening and centres instead. */
      max-width: var(--split-max);
      margin-inline: auto;
    }

    /* The site footer (its own section, after <main>) sits on the information
       column and should end level with the last media. The media column
       therefore claims that much less height, so the footer rises beside it;
       if the information is taller, the footer simply follows it. The media
       paints above the footer's empty left side. */
    .pdp__media {
      position: relative;
      z-index: 1;
      margin-bottom: calc(-1 * (var(--site-footer-gap) + var(--site-footer-block)));
    }

    /* Desktop: every media in one column, each in the same frame; the next one
       shows beneath the first at the fold, as in the Figma. */
    .pdp__slides {
      display: grid;
      row-gap: 19px;
      overflow: visible;
    }

    .pdp__index {
      display: none;
    }

    /* The title sits 122px below the media top at 1280px. */
    .pdp__info {
      padding-top: clamp(24px, 9.53vw, 160px);
    }
  }

  @media (max-width: 700px) {
    .pdp {
      padding-top: 4px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .pdp *,
    .pdp *::before,
    .pdp *::after {
      transition-duration: 1ms !important;
      transition-delay: 0s !important;
      scroll-behavior: auto !important;
    }
  }
{% endstylesheet %}

{% javascript %}
  (function () {
    'use strict';

    var ROOT = '[data-pdp]';

    function pad(n) {
      return n < 10 ? '0' + n : String(n);
    }

    function init(root) {
      if (root.dataset.pdpReady === 'true') return;

      var data = root.querySelector('[data-pdp-variants]');
      if (!data) return;

      var variants;
      try {
        variants = JSON.parse(data.textContent);
      } catch (e) {
        // Leave the server-rendered form untouched rather than half-enhance it.
        return;
      }

      root.dataset.pdpReady = 'true';

      var fieldsets = Array.prototype.slice.call(root.querySelectorAll('[data-pdp-option]'));
      var select = root.querySelector('[data-pdp-variant-select]');
      var submit = root.querySelector('[data-pdp-submit]');
      var dynamic = root.querySelector('[data-pdp-dynamic]');
      var price = root.querySelector('[data-pdp-price]');
      var priceLabel = root.querySelector('[data-pdp-price-label]');
      var compare = root.querySelector('[data-pdp-compare]');
      var compareValue = root.querySelector('[data-pdp-compare-value]');
      var status = root.querySelector('[data-pdp-status]');
      var live = root.querySelector('[data-pdp-live]');

      var track = root.querySelector('[data-pdp-slides]');
      var slides = Array.prototype.slice.call(root.querySelectorAll('[data-pdp-slide]'));
      var index = root.querySelector('[data-pdp-index]');
      var active = Math.max(0, slides.findIndex(function (s) { return s.classList.contains('is-active'); }));
      var reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

      /* ---------- Media ---------- */

      // Phone CSS lays the slides out as a scroll-snap track; desktop shows them
      // all in a column. Asking the layout keeps breakpoints in CSS only.
      function isTrack() {
        return track && track.scrollWidth > track.clientWidth + 1;
      }

      function showMedia(i, scroll) {
        if (i < 0 || i >= slides.length) return;
        if (i !== active) {
          slides[active].classList.remove('is-active');
          var video = slides[active].querySelector('video');
          if (video) video.pause();
        }
        active = i;
        slides[i].classList.add('is-active');
        if (index) index.textContent = pad(i + 1);
        if (scroll && isTrack()) {
          track.scrollTo({
            left: slides[i].offsetLeft - track.offsetLeft,
            behavior: reduceMotion.matches || scroll === 'instant' ? 'auto' : 'smooth'
          });
        }
      }

      if (track) {
        var ticking = false;
        track.addEventListener('scroll', function () {
          if (ticking || !isTrack()) return;
          ticking = true;
          requestAnimationFrame(function () {
            ticking = false;
            var i = Math.round(track.scrollLeft / track.clientWidth);
            if (i !== active) showMedia(i, false);
          });
        }, { passive: true });

        // Crossing into the track layout (or loading on a variant's media)
        // needs the scroll position to match the active slide.
        var resizeTimer;
        window.addEventListener('resize', function () {
          clearTimeout(resizeTimer);
          resizeTimer = setTimeout(function () { showMedia(active, 'instant'); }, 150);
        });
        if (active > 0) showMedia(active, 'instant');
      }

      /* ---------- Variants ---------- */

      function selectedOptions() {
        return fieldsets.map(function (fs) {
          var checked = fs.querySelector('input:checked');
          return checked ? checked.value : null;
        });
      }

      function findVariant(options) {
        for (var i = 0; i < variants.length; i++) {
          var v = variants[i];
          var match = true;
          for (var j = 0; j < options.length; j++) {
            if (v.options[j] !== options[j]) { match = false; break; }
          }
          if (match) return v;
        }
        return null;
      }

      // Each value is judged against the *other* current selections, so a value
      // is only "sold out" or "unavailable" for the combination it would make.
      function updateValueStates(options) {
        fieldsets.forEach(function (fs, i) {
          fs.querySelectorAll('input').forEach(function (input) {
            var candidate = options.slice();
            candidate[i] = input.value;
            var v = findVariant(candidate);
            var state = !v ? 'unavailable' : v.available ? 'available' : 'soldout';
            var label = input.nextElementSibling;
            label.dataset.state = state;
            var note = label.querySelector('[data-pdp-value-state]');
            if (note) note.textContent = state === 'soldout' ? ', sold out' : state === 'unavailable' ? ', unavailable' : '';
          });
        });
      }

      function render(variant, announce) {
        var state = !variant ? 'unavailable' : variant.available ? 'available' : 'soldout';

        if (variant) select.value = String(variant.id);
        else select.selectedIndex = -1;

        if (variant) {
          price.textContent = variant.price;
          compare.hidden = !variant.compare;
          if (variant.compare) compareValue.textContent = variant.compare;
          priceLabel.textContent = variant.compare ? 'Sale price' : 'Price';
        }

        var statusText = state === 'available' ? 'Available' : state === 'soldout' ? 'Sold out' : 'Unavailable';
        status.textContent = statusText;

        submit.disabled = state !== 'available';
        submit.textContent =
          state === 'available' ? submit.dataset.labelAdd :
          state === 'soldout' ? submit.dataset.labelSoldout : submit.dataset.labelUnavailable;
        if (dynamic) dynamic.hidden = state !== 'available';

        if (variant && variant.media) {
          var slideIndex = slides.findIndex(function (s) { return s.dataset.mediaId === String(variant.media); });
          if (slideIndex !== -1) showMedia(slideIndex, true);
        }

        if (variant) {
          var url = new URL(window.location.href);
          url.searchParams.set('variant', variant.id);
          window.history.replaceState(window.history.state, '', url.toString());
        }

        if (announce && live) {
          live.textContent = (variant ? variant.title + ', ' + variant.price + ', ' : '') + statusText;
        }
      }

      fieldsets.forEach(function (fs) {
        fs.addEventListener('change', function () {
          var options = selectedOptions();
          updateValueStates(options);
          render(findVariant(options), true);
        });
      });

      /* ---------- Quantity ---------- */

      var qtyInput = root.querySelector('[data-pdp-qty-input]');
      var qtyButtons = Array.prototype.slice.call(root.querySelectorAll('[data-pdp-qty]'));

      // At the minimum the minus stays focusable and looks as drawn; it is only
      // marked disabled for assistive tech.
      function syncQty() {
        var min = Number(qtyInput.min) || 1;
        qtyButtons.forEach(function (b) {
          if (Number(b.dataset.pdpQty) < 0) b.setAttribute('aria-disabled', String((Number(qtyInput.value) || min) <= min));
        });
      }

      if (qtyInput) {
        qtyButtons.forEach(function (b) {
          b.addEventListener('click', function () {
            var min = Number(qtyInput.min) || 1;
            var next = (Number(qtyInput.value) || min) + Number(b.dataset.pdpQty);
            if (next < min) return;
            qtyInput.value = next;
            qtyInput.dispatchEvent(new Event('change', { bubbles: true }));
          });
        });
        qtyInput.addEventListener('change', function () {
          var min = Number(qtyInput.min) || 1;
          if (!(Number(qtyInput.value) >= min)) qtyInput.value = min;
          syncQty();
        });
        syncQty();
      }

      /* ---------- Disclosures ---------- */

      var notes = root.querySelector('[data-pdp-notes]');
      if (notes) {
        notes.addEventListener('click', function (event) {
          var toggle = event.target.closest('[data-pdp-toggle]');
          if (!toggle) return;
          var open = toggle.getAttribute('aria-expanded') !== 'true';
          // One slot under the row: opening one closes the other.
          notes.querySelectorAll('[data-pdp-toggle]').forEach(function (t) {
            var isTarget = t === toggle;
            t.setAttribute('aria-expanded', String(isTarget && open));
            document.getElementById(t.getAttribute('aria-controls')).hidden = !(isTarget && open);
          });
        });
      }
    }

    function initAll(scope) {
      (scope || document).querySelectorAll(ROOT).forEach(init);
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', function () { initAll(); });
    } else {
      initAll();
    }

    document.addEventListener('shopify:section:load', function (event) {
      initAll(event.target);
    });
  })();
{% endjavascript %}

{% schema %}
{
  "name": "t:general.product",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_dynamic_checkout",
      "label": "Show dynamic checkout buttons",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "preview_size_guide",
      "label": "Show sample size guide for design preview",
      "info": "Temporary. Shows example measurements on products with no size guide data. Never use on a live store.",
      "default": false
    }
  ],
  "disabled_on": {
    "groups": ["header", "footer"]
  }
}
{% endschema %}
