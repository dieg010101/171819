{% doc %}
  Size guide: a CM / IN switch, then measurements by size as a table set in
  plain text (no cell boxes).

  Presentation only. It takes one normalised shape, so whatever eventually
  supplies the guide only has to be mapped to it: the Sanity size guide's JSON
  `measurements: [{ label, values: [] }]` maps with `map: 'label'` and by
  `concat`-ing each row's values.

  The caller decides whether a guide exists; this renders whatever it is given.

  @param {string} unit - Unit the values are authored in: 'cm' or 'in'
  @param {string[]} sizes - Column labels, e.g. S, M, L (independent of the variant options)
  @param {string[]} rows - Measurement names, one per row, e.g. Length, Waist
  @param {number[]} values - Numbers, row by row: rows.size × sizes.size entries
  @param {string} [note] - Line shown under the measurements

  @example
  {% render 'product-size-guide', unit: 'cm', sizes: sizes, rows: rows, values: values, note: note %}
{% enddoc %}

{%- liquid
  assign authored_unit = 'cm'
  if unit == 'in'
    assign authored_unit = 'in'
  endif
  assign columns = sizes.size
  assign unit_options = 'cm,in' | split: ','
-%}

<div class="size-guide" data-size-guide data-size-guide-unit="{{ authored_unit }}">
  <div class="size-guide__units" role="group" aria-label="Units">
    {%- for option in unit_options -%}
      <button
        class="size-guide__unit"
        type="button"
        data-size-guide-unit-option="{{ option }}"
        aria-pressed="{% if option == authored_unit %}true{% else %}false{% endif %}"
      >
        {{- option | upcase -}}
      </button>
    {%- endfor -%}
  </div>

  {%- comment -%}
    Phones: the unit as one "CM ⌄" that opens the phone's own picker; the
    select is invisible over it. Shown in place of the switch above on
    phones (see the phone pickers block below).
  {%- endcomment -%}
  <div class="size-guide__picker" data-size-guide-picker>
    <span class="size-guide__picker-value" aria-hidden="true">
      <span data-size-guide-picker-value>{{ authored_unit | upcase }}</span>
      {%- render 'icon-chevron-down', class: 'size-guide__picker-chevron' -%}
    </span>
    <select class="size-guide__picker-select" aria-label="Units" data-size-guide-unit-select>
      <option value="cm" {% if authored_unit == 'cm' %}selected{% endif %}>Centimetres (CM)</option>
      <option value="in" {% if authored_unit == 'in' %}selected{% endif %}>Inches (IN)</option>
    </select>
  </div>

  <div class="size-guide__body">
    <div class="size-guide__scroll">
      <table class="size-guide__table">
        <caption class="size-guide__sr" data-size-guide-caption>
          Measurements in {% if authored_unit == 'in' %}inches{% else %}centimetres{% endif %}
        </caption>
        <thead>
          <tr>
            <td></td>
            {%- for size in sizes -%}
              <th scope="col">{{ size }}</th>
            {%- endfor -%}
          </tr>
        </thead>
        <tbody>
          {%- for row in rows -%}
            {%- assign offset = forloop.index0 | times: columns -%}
            <tr>
              <th scope="row">{{ row }}</th>
              {%- for size in sizes -%}
                {%- assign value = values[offset] -%}
                {%- assign offset = offset | plus: 1 -%}
                {%- if value != blank -%}
                  <td data-size-guide-value="{{ value }}">{{ value }}</td>
                {%- else -%}
                  <td></td>
                {%- endif -%}
              {%- endfor -%}
            </tr>
          {%- endfor -%}
        </tbody>
      </table>
    </div>

    {%- if note != blank -%}
      <p class="size-guide__note">{{ note }}</p>
    {%- endif -%}
  </div>
</div>

{%- comment -%} The switch needs JS; without it the values simply stay in their authored unit. {%- endcomment -%}
<noscript>
  <style>
    .size-guide__units,
    .size-guide__picker { display: none !important; }
  </style>
</noscript>

{% stylesheet %}
  /*
    Figma, 1280px: names start at 980, value columns at 1048 / 1084 / 1122 /
    1158 / 1199 (an even ~37.75px pitch), rows every 25px, all 10/12. The last
    column is only as wide as its text, so the table ends flush with its
    container whatever the number of sizes.
  */
  .size-guide {
    --size-guide-pitch: 37.75px;
    --size-guide-label: 68px;

    display: flex;
    flex-direction: column;
    align-items: flex-end;
    font-size: 10px;
    line-height: 12px;
    letter-spacing: -0.05em;
  }

  .size-guide__sr {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
    border: 0;
  }

  .size-guide__units {
    display: flex;
    gap: 8px;
  }

  .size-guide__unit {
    position: relative;
    padding: 0;
    border: 0;
    border-radius: 0;
    background: none;
    color: inherit;
    font: inherit;
    letter-spacing: inherit;
    cursor: pointer;
  }

  /* A larger, invisible hit area that never moves the text. */
  .size-guide__unit::before {
    content: '';
    position: absolute;
    inset: -8px -3px;
  }

  /* The active unit: a short rule 7px under the text, as in the Figma. */
  .size-guide__unit::after {
    content: '';
    position: absolute;
    inset: auto 0 -7px;
    height: 1px;
    background-color: currentcolor;
    opacity: 0;
  }

  /* The only cue for the active unit, so 3:1 against the background. */
  .size-guide__unit[aria-pressed='true']::after {
    opacity: 0.35;
  }

  .size-guide__unit:focus-visible {
    outline: 1px solid currentcolor;
    outline-offset: 2px;
  }

  .size-guide__picker {
    position: relative;
    display: none;
  }

  .size-guide__picker-value {
    display: inline-flex;
    align-items: center;
    gap: 14px;
    font-size: 11px;
  }

  /* 16px, so iOS doesn't zoom to it. */
  .size-guide__picker-select {
    position: absolute;
    inset: -8px -10px;
    opacity: 0;
    font-size: 16px;
    cursor: pointer;
    appearance: none;
  }

  .size-guide__picker:has(.size-guide__picker-select:focus-visible) {
    outline: 1px solid currentcolor;
    outline-offset: 2px;
  }

  /* Phone pickers (with the product page's matching block): to go back to the
     laid-out CM / IN on phones, comment out this block. */
  @media (max-width: 700px) {
    .size-guide__units {
      display: none;
    }

    .size-guide__picker {
      display: block;
    }
  }
  /* End phone pickers. */

  .size-guide__body {
    width: max-content;
    max-width: 100%;
    margin-top: 20px;
  }

  /* Only the table scrolls, and only if a long guide outgrows a phone. */
  .size-guide__scroll {
    overflow-x: auto;
    scrollbar-width: none;
  }

  .size-guide__table {
    border-collapse: collapse;
    font-variant-numeric: tabular-nums;
  }

  .size-guide__table :is(th, td) {
    width: var(--size-guide-pitch);
    height: 25px;
    padding: 0;
    font-weight: 400;
    text-align: left;
    vertical-align: top;
    white-space: nowrap;
  }

  .size-guide__table thead :is(th, td) {
    height: 24px;
  }

  .size-guide__table :is(th, td):first-child {
    width: var(--size-guide-label);
    padding-right: 8px;
  }

  .size-guide__table :is(th, td):last-child {
    width: auto;
  }

  /* Both units share one spot and only one shows, so every column is always
     as wide as its widest value in either unit: switching never moves the
     table. */
  .size-guide__value {
    display: inline-grid;
  }

  .size-guide__value > * {
    grid-area: 1 / 1;
  }

  .size-guide__value > :not(.is-shown) {
    visibility: hidden;
  }

  /* As wide as the table, never wider: it wraps rather than pushing the
     table off the right edge. */
  .size-guide__note {
    width: 0;
    min-width: 100%;
    margin: 7px 0 0;
  }
{% endstylesheet %}

{% javascript %}
  (function () {
    'use strict';

    /* ---------- Units: pure, no DOM ---------- */

    var CM_PER_IN = 2.54;
    var UNIT_NAMES = { cm: 'centimetres', in: 'inches' };

    function convert(value, from, to) {
      if (from === to) return value;
      return from === 'cm' ? value / CM_PER_IN : value * CM_PER_IN;
    }

    // Always one decimal, so a converted column never mixes 28 with 27.9.
    function format(value) {
      return value.toFixed(1);
    }

    /* ---------- DOM ---------- */

    // Each cell gets both units up front, stacked in one spot (see
    // .size-guide__value), so columns are sized for both before the first
    // switch. Always converted from the authored value, so switching back and
    // forth never accumulates rounding; the authored unit shows the value
    // exactly as rendered by Liquid, whatever its precision.
    function prepare(guide) {
      if (guide.dataset.sizeGuideReady === 'true') return;
      guide.dataset.sizeGuideReady = 'true';
      var authored = guide.dataset.sizeGuideUnit;
      guide.querySelectorAll('[data-size-guide-value]').forEach(function (cell) {
        var value = cell.dataset.sizeGuideValue;
        var wrap = document.createElement('span');
        wrap.className = 'size-guide__value';
        Object.keys(UNIT_NAMES).forEach(function (unit) {
          var span = document.createElement('span');
          span.dataset.sizeGuideIn = unit;
          span.textContent = unit === authored ? value : format(convert(Number(value), authored, unit));
          if (unit === authored) span.className = 'is-shown';
          wrap.appendChild(span);
        });
        cell.textContent = '';
        cell.appendChild(wrap);
      });
    }

    function prepareAll(scope) {
      (scope || document).querySelectorAll('[data-size-guide]').forEach(prepare);
    }

    function setUnit(guide, unit) {
      prepare(guide);
      guide.querySelectorAll('[data-size-guide-in]').forEach(function (span) {
        span.classList.toggle('is-shown', span.dataset.sizeGuideIn === unit);
      });
      guide.querySelectorAll('[data-size-guide-unit-option]').forEach(function (button) {
        button.setAttribute('aria-pressed', String(button.dataset.sizeGuideUnitOption === unit));
      });
      var picker = guide.querySelector('[data-size-guide-unit-select]');
      if (picker) picker.value = unit;
      var pickerValue = guide.querySelector('[data-size-guide-picker-value]');
      if (pickerValue) pickerValue.textContent = unit.toUpperCase();
      var caption = guide.querySelector('[data-size-guide-caption]');
      if (caption) caption.textContent = 'Measurements in ' + UNIT_NAMES[unit];
    }

    document.addEventListener('click', function (event) {
      var button = event.target.closest('[data-size-guide-unit-option]');
      if (!button) return;
      var guide = button.closest('[data-size-guide]');
      if (guide) setUnit(guide, button.dataset.sizeGuideUnitOption);
    });

    document.addEventListener('change', function (event) {
      var picker = event.target.closest('[data-size-guide-unit-select]');
      if (!picker) return;
      var guide = picker.closest('[data-size-guide]');
      if (guide) setUnit(guide, picker.value);
    });

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', function () { prepareAll(); });
    } else {
      prepareAll();
    }

    document.addEventListener('shopify:section:load', function (event) {
      prepareAll(event.target);
    });
  })();
{% endjavascript %}
