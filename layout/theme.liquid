<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    {% # Inlined CSS Variables %}
    {% render 'css-variables' %}

    {% comment %}
      Font preloading:
      1. Preconnect to font CDN for faster connection
      2. Preload only the critical font variant (base weight)
      3. Additional variants load on-demand via @font-face
    {% endcomment %}
    {% unless settings.type_primary_font.system? %}
      <link rel="preconnect" href="https://fonts.shopifycdn.com" crossorigin>

      {% comment %} Preload the base font variant for initial page render {% endcomment %}
      {{ settings.type_primary_font | font_url | preload_tag: as: 'font', crossorigin: 'anonymous' }}
    {% endunless %}

    {% # Load and preload the critical CSS %}
    {{ 'critical.css' | asset_url | stylesheet_tag: preload: true }}

    {% # Social, title, etc. %}
    {% render 'meta-tags' %}

    {{ content_for_header }}
  </head>

  <body>
    {% comment %}
      Flock intro: homepage only, and never in the theme editor, where a full-page
      overlay would block merchants from selecting and editing sections.

      Deferred scripts execute in document order, so this order is the dependency
      order: p5 runtime, then the sketch that uses it, then the DOM adapter.
      Do not switch these to async.
    {% endcomment %}
    {% if request.page_type == 'index' and request.design_mode != true %}
      {% render 'flock-intro' %}

      <script src="{{ 'p5.min.js' | asset_url }}" defer></script>
      <script src="{{ 'flock-transition.js' | asset_url }}" defer></script>
      <script src="{{ 'flock-intro.js' | asset_url }}" defer></script>
    {% endif %}

    {% sections 'header-group' %}

    {{ content_for_layout }}

    {% sections 'footer-group' %}
  </body>
</html>
