<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    {% # Inlined CSS Variables %}
    {% render 'css-variables' %}

    {% comment %}
      Type is Helvetica Neue from the visitor's device (see
      snippets/css-variables.liquid), so there is no font to preload. To
      return to the theme editor's fonts, restore:

    {% # The page is set entirely in the secondary font. %}
    {% unless settings.type_secondary_font.system? %}
      {{ settings.type_secondary_font | font_url | preload_tag: as: 'font', crossorigin: 'anonymous' }}
    {% endunless %}
    {% endcomment %}

    {% # Load and preload the critical CSS %}
    {{ 'critical.css' | asset_url | stylesheet_tag: preload: true }}

    {% # Social, title, etc. %}
    {% render 'meta-tags' %}

    {{ content_for_header }}
  </head>

  <body>
    <main id="MainContent">
      {{ content_for_layout }}
    </main>

    {% comment %}
      The hawks over the password page (sections/password.liquid). Deferred
      scripts run in document order: the p5 runtime, then the sketch.
    {% endcomment %}
    <script src="{{ 'p5.min.js' | asset_url }}" defer></script>
    <script src="{{ 'password-flock.js' | asset_url }}" defer></script>
  </body>
</html>
